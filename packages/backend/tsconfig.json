{
  "compilerOptions": {
    "lib": ["ES2022"],
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "@5dcol/core": ["../core/src/index.ts"],
      "@5dcol/core/fiveDPGN": ["../core/src/fiveDPGN.ts"],
      "@5dcol/shared": ["../shared/src/index.ts"],
      "@5dcol/shared/protocol": ["../shared/src/protocol.ts"]
    }
  },
  "include": ["./src"]
}
