{
  "name": "@5dcol/core",
  "version": "0.0.0",
  "description": "Core 5D Chess game logic for 5dcol.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./fiveDPGN": {
      "types": "./dist/fiveDPGN.d.ts",
      "import": "./dist/fiveDPGN.js",
      "require": "./dist/fiveDPGN.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "license": "MIT",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "typescript": "^5.9.3",
    "vite": "^8.0.10"
  },
  "dependencies": {
    "mutative": "^1.3.0"
  }
}
